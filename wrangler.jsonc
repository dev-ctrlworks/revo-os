{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "revoos",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "revoos"
    }
  ],
  "routes": [
    {
      "pattern": "revoos.app",
      "zone_name": "revoos.app",
      "custom_domain": true
    },
    {
      "pattern": "www.revoos.app",
      "zone_name": "revoos.app",
      "custom_domain": true
    },
    {
      "pattern": "revoos.ctrlworks.co",
      "zone_name": "ctrlworks.co",
      "custom_domain": true
    }
  ]
}