# Revo OS — environment variables
# Copy to .env.local and fill in.

# OpenAI key for real AI answers (optional — falls back to canned answers when unset).
OPENAI_API_KEY=
# Optional: override the default model (gpt-4o-mini).
OPENAI_MODEL=

# Supabase project for the waitlist + feedback widget.
# Find these in the Supabase dashboard (Project Settings → API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=