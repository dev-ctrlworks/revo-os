# Revo OS — environment variables
# Copy to .env.local and fill in.

# --- Application ---
# Public base URL of the deployment (used for auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) ---
# Project URL and anon key. The anon key is browser-safe and protected by RLS.
# Find them in the Supabase dashboard (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose to the browser or commit.
# Used for account deletion and storage cleanup.
SUPABASE_SERVICE_ROLE_KEY=

# --- OAuth (optional; buttons stay disabled until configured in Supabase) ---
# Enable "Google" and "Apple" under Supabase → Authentication → Providers.
# These flags only control whether the sign-in buttons are shown; the providers
# themselves must be configured in Supabase before the buttons will work.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_AUTH_APPLE_ENABLED=

# --- AI (optional; answers show an honest "AI unavailable" state when unset) ---
OPENAI_API_KEY=
# Optional: override the default model (gpt-4o-mini).
OPENAI_MODEL=

# --- Optional integrations ---
# Generic webhook (Slack/Discord/PagerDuty-compatible) that receives a JSON
# record for every server-side error. Unset = log to Workers Logs only.
ERROR_WEBHOOK_URL=
